# =========================================================================
# EVER COFFEE HOUSE - ENVIRONMENT CONFIGURATION
# Set these variables in your Vercel Project Settings (Project -> Settings -> Environment Variables)
# or in a local .env file for development.
# =========================================================================

# --- 1. SUPABASE POSTGRESQL (Permanent Cloud Database) ---
# Retrieve from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Secret Service Role Key (Used only on the server, NEVER exposed to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# --- 2. VERCEL BLOB (Permanent Cloud Image Storage) ---
# Automatically populated by Vercel when you create a Blob store in Dashboard -> Storage -> Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token_here

# --- 3. SECURITY & AUTHENTICATION ---
# Random secret string for signing JWT administrator tokens
JWT_SECRET=ever-coffee-house-super-secure-production-key-2025

# --- 4. SERVER CONFIGURATION (Optional for local dev) ---
PORT=5050
